---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await product.render();
const { title, equivalent, pitch, category, heroImage, specs } = product.data;
---

<Layout title={`${title} | Konnra Electronics`} description={`Discover ${title} with ${pitch} pitch and high-reliability specifications.`}>
  <main class="product-detail-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a> &gt; <a href="/cross-reference/">Products</a> &gt; <span>{title}</span>
    </nav>

    <div class="product-grid">
      <!-- Left: Visual & Images -->
      <div class="product-media-card">
        <div class="hero-image-wrap">
          <img src={heroImage || "/brand/kr4203-hero.jpg"} alt={title} class="main-product-img" onerror="this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80'" />
        </div>
        {equivalent && (
          <div class="equivalent-badge">
            <span class="badge-label">Cross Equivalent:</span>
            <strong>{equivalent}</strong>
          </div>
        )}
      </div>

      <!-- Right: Primary Specs & CTA -->
      <div class="product-info-card">
        <span class="category-tag">{category} · {pitch} Pitch</span>
        <h1 class="product-title">{title}</h1>

        <div class="specs-table-wrap">
          <h3>Technical Specifications</h3>
          <table class="specs-table">
            <tbody>
              <tr><td>Pitch Size</td><td><strong>{pitch}</strong></td></tr>
              <tr><td>Current Rating</td><td>{specs?.currentRating || '9.0A AC/DC'}</td></tr>
              <tr><td>Voltage Rating</td><td>{specs?.voltageRating || '600V AC/DC'}</td></tr>
              <tr><td>Contact Resistance</td><td>{specs?.contactResistance || '10 mΩ Max'}</td></tr>
              <tr><td>Insulation Resistance</td><td>{specs?.insulationResistance || '1000 MΩ Min'}</td></tr>
              <tr><td>Operating Temp</td><td>{specs?.tempRange || '-40°C ~ +105°C'}</td></tr>
              <tr><td>Circuits</td><td>{specs?.circuits || '2-24 Circuits'}</td></tr>
            </tbody>
          </table>
        </div>

        <div class="action-row">
          <a href="/contact-us/" class="btn-primary">Request Free Sample &amp; Quote</a>
          <a href="/cross-reference/" class="btn-secondary">Check Cross-Reference List</a>
        </div>
      </div>
    </div>

    <!-- Bottom: Rich Text Body / Description -->
    <section class="product-body-content">
      <Content />
    </section>
  </main>
</Layout>

<style>
  .product-detail-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .breadcrumb {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 24px;
  }
  .breadcrumb a { color: #0284c7; text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 50px;
  }
  @media (max-width: 768px) {
    .product-grid { grid-template-columns: 1fr; }
  }

  .product-media-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-image-wrap {
    width: 100%;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
  }
  .main-product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .equivalent-badge {
    margin-top: 18px;
    background: #e0f2fe;
    color: #0369a1;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    width: fit-content;
  }

  .product-info-card {
    display: flex;
    flex-direction: column;
  }
  .category-tag {
    font-size: 13px;
    font-weight: 600;
    color: #0284c7;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }
  .product-title {
    font-size: 28px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
    margin: 0 0 20px;
  }

  .specs-table-wrap {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 24px;
  }
  .specs-table-wrap h3 {
    margin: 0 0 14px;
    font-size: 16px;
    color: #1e293b;
  }
  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .specs-table tr {
    border-bottom: 1px solid #f1f5f9;
  }
  .specs-table tr:last-child { border-bottom: none; }
  .specs-table td {
    padding: 8px 6px;
    color: #475569;
  }
  .specs-table td:first-child {
    color: #64748b;
    width: 45%;
  }

  .action-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: #0284c7;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #0369a1; }
  .btn-secondary {
    background: #f1f5f9;
    color: #334155;
    padding: 12px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
  }
  .btn-secondary:hover { background: #e2e8f0; }

  .product-body-content {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    padding-top: 36px;
    color: #334155;
    line-height: 1.7;
  }
</style>
