  var norm = function (s) { return s.toLowerCase().replace(/[^a-z0-9.一-鿿]+/g, ' ').trim(); };
  var flat = function (s) { return s.replace(/[^a-z0-9]/g, ''); };
  var idx = rows.map(function (r) { var d = norm(r.getAttribute('data-q')); return d + ' ' + flat(d); });
  function run() {
    var term = norm(q.value), f = flat(term), n = 0, on = !!term;
